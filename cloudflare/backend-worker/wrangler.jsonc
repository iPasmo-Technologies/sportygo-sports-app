{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sportygo-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3001",
    "DATABASE_SSL": "true",
    "DATABASE_CONNECTION_TIMEOUT_MS": "5000",
    "DATABASE_POOL_MAX": "10",
    "STRIPE_CURRENCY": "sgd"
  },
  "containers": [
    {
      "class_name": "SportyGoContainer",
      "image": "../../Dockerfile.backend",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SPORTYGO_CONTAINER",
        "class_name": "SportyGoContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SportyGoContainer"]
    }
  ]
}
